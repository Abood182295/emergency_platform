<div style="max-width: 400px; margin: 3rem auto; font-family: system-ui, sans-serif;">
  <h2>Sign In - Emergency Platform</h2>

  <% if flash[:alert] %>
    <p style="padding: 0.75rem; background-color: #f8d7da; color: #721c24; border-radius: 4px;"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: login_path, method: :post, local: true, data: { turbo: false } do |f| %>
    <div style="margin-bottom: 1rem;">
      <%= f.label :email %><br>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 0.5rem;" %>
    </div>

    <div style="margin-bottom: 1rem;">
      <%= f.label :password %><br>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 0.5rem;" %>
    </div>

    <div>
      <%= f.submit "Sign In", style: "padding: 0.5rem 1rem; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 4px;" %>
    </div>
  <% end %>
</div>