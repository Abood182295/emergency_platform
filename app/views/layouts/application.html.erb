<!DOCTYPE html>
<html>
  <head>
    <title>منصة إدارة الطوارئ والأزمات - حائل</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- ربط Bootstrap RTL للتصميم العربي السريع والنظيف -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>

  <body dir="rtl" class="bg-light">
    
    <!-- شريط التنقل العلوي (Navbar) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/">🚨 منصة الطوارئ - حائل</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/">الرئيسية</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/citizens/new">تقديم بلاغ</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/responders">لوحة المستجيب</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/users">إدارة المستخدمين</a>
            </li>
          </ul>
          <div class="d-flex">
            <a href="/login" class="btn btn-outline-light btn-sm">تسجيل الدخول</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- منطقة المحتوى المتغير للصفحات -->
    <main class="container my-4">
      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </main>

    <!-- حقوق النشر وتذييل الصفحة -->
    <footer class="text-center py-3 text-muted mt-auto border-top">
      <p class="mb-0">منصة إدارة الطوارئ والأزمات الموحدة - مدينة حائل © 2026</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>